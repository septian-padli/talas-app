{
	"info": {
		"_postman_id": "8b5f3a0a-4b9e-4e8c-9d1a-2e5c8f3b1c1d",
		"name": "Talas Content Service - Collaborations",
		"description": "Postman Collection for Collaboration Module Endpoints (Invite, Response, List, Remove).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Showcase Level",
			"item": [
				{
					"name": "Get Showcase Collaborators",
					"request": {
						"method": "GET",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": {
							"raw": "{{baseUrl}}/showcases/{{showcaseId}}/collaborators",
							"host": ["{{baseUrl}}"],
							"path": ["showcases", "{{showcaseId}}", "collaborators"],
							"variable": [
								{ "key": "id", "value": "", "description": "Showcase UUID" }
							]
						},
						"description": "Menampilkan list collaborator dari sebuah showcase."
					},
					"response": []
				},
				{
					"name": "Invite Collaborators",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usernames\": [\"user1\", \"user2\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/showcases/{{showcaseId}}/collaborators",
							"host": ["{{baseUrl}}"],
							"path": ["showcases", "{{showcaseId}}", "collaborators"],
							"variable": [
								{ "key": "id", "value": "", "description": "Showcase UUID" }
							]
						},
						"description": "Mengundang satu atau lebih user sebagai collaborator."
					},
					"response": []
				},
				{
					"name": "Remove Collaborator / Leave Project",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/showcases/{{showcaseId}}/collaborators/:userId",
							"host": ["{{baseUrl}}"],
							"path": [
								"showcases",
								"{{showcaseId}}",
								"collaborators",
								":userId"
							],
							"variable": [
								{ "key": "id", "value": "", "description": "Showcase UUID" },
								{
									"key": "userId",
									"value": "",
									"description": "Target User UUID (or Self)"
								}
							]
						},
						"description": "Menghapus collaborator atau keluar dari project."
					},
					"response": []
				}
			]
		},
		{
			"name": "Global / User Level",
			"item": [
				{
					"name": "Get Pending Invitations",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/collaborations/invitations?limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["collaborations", "invitations"],
							"query": [
								{ "key": "limit", "value": "10" },
								{ "key": "cursor", "value": "", "disabled": true }
							]
						},
						"description": "Mendapatkan daftar undangan kolaborasi yang statusnya PENDING."
					},
					"response": []
				},
				{
					"name": "Cancel / Revoke Invitation",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/collaborations/invitations/{{collaboratorId}}",
							"host": ["{{baseUrl}}"],
							"path": ["collaborations", "invitations", "{{collaboratorId}}"],
							"variable": [
								{
									"key": "id",
									"value": "",
									"description": "Invitation UUID (Collaborator ID)"
								}
							]
						},
						"description": "Membatalkan undangan yang masih PENDING (Owner only)."
					},
					"response": []
				},
				{
					"name": "Respond to Invitation",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"response\": \"ACCEPTED\" \n}"
						},
						"url": {
							"raw": "{{baseUrl}}/collaborations/{{collaboratorId}}/response",
							"host": ["{{baseUrl}}"],
							"path": ["collaborations", "{{collaboratorId}}", "response"],
							"variable": [
								{
									"key": "id",
									"value": "",
									"description": "Invitation UUID (Collaborator ID)"
								}
							]
						},
						"description": "Menerima (ACCEPTED) atau menolak (REJECTED) undangan."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8001/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string",
			"description": "JWT Token for Authorization"
		}
	]
}
